<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct web access to sensitive configuration files
    <FilesMatch "(^\..*|composer\.(json|lock)|package(-lock)?\.json|artisan|\.env(\..*)?|phpunit\.xml)$">
        Require all denied
    </FilesMatch>

    # 2. Disable directory listing for security
    Options -Indexes

    # 3. Handle Authorization & CSRF Header for APIs and requests
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 4. Redirect all requests seamlessly to the /public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
